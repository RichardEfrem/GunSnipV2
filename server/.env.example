# Copy to .env and adjust. Every variable here is validated at boot by src/config/env.schema.ts —
# a missing or malformed value stops the process rather than failing later.

NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://gunsnip:gunsnip@localhost:5432/gunsnip?schema=public

# Guest session cookie (PRD §11.1)
SESSION_COOKIE_NAME=gs_session
SESSION_COOKIE_MAX_AGE_DAYS=365

# Phase 0 admin secret (PRD §11.2). Minimum 16 characters.
# Generate one with: openssl rand -hex 24
ADMIN_KEY=replace-me-with-a-real-secret

# Payment provider is selected here, never by branching in business logic (PRD §11.3)
PAYMENT_PROVIDER=mock
PAYMENT_EXPIRY_HOURS=24

MAILER_TRANSPORT=console

# Gates the dev-only payment simulate endpoint (FR-PAY-05). Never true in production.
ENABLE_DEV_ENDPOINTS=true
