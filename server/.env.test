# The integration-test database, read only by the e2e suite (test/test-env.ts).
#
# Committed on purpose: it names a local database with the same development credentials as
# .env.example, and holds nothing secret. The suite rebuilds this database from the migrations
# and the seed before every run, so it must never point at one whose contents matter — the
# global setup refuses any database whose name does not end in _test.
DATABASE_URL=postgresql://gunsnip:gunsnip@localhost:5432/gunsnip_test?schema=public

# The order limiter buckets by IP and the whole suite is one address, so the checkout specs would
# throttle each other at the real default. Raised out of the way here; the limiter's own behaviour
# is proved in order-rate-limit.e2e-spec.ts, which boots an app with a limit of its own.
ORDER_RATE_LIMIT=1000

# Pinned here rather than inherited from a developer's .env, so the payment specs prove the same
# thing on every machine: the simulate endpoint is reachable (FR-PAY-05).
ENABLE_DEV_ENDPOINTS=true

# Uploads land beside, not inside, the development media folder.
MEDIA_DIR=storage/media-test
