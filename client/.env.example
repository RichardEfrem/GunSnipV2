# Copy to .env.local. Validated at module load by src/lib/env.ts — a missing or malformed
# value fails the build rather than surfacing as an undefined URL in a fetch later.

# The NestJS API, including its /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# The storefront's own public origin. Canonical URLs and Product JSON-LD are absolute
# (FR-PDP-14), and a relative one in structured data is silently ignored by crawlers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
