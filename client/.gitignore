# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents what has to be set and holds no secrets.
# Matches how server/.env.example is handled.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Imagery generated by the server seed. Regenerated by `npm run db:seed -w server`, and
# meaningless without the rows it belongs to — every file here is derived, never authored.
#   products/ — image-placeholder.ts
#   banners/  — banner-placeholder.ts
#   reviews/  — review-photo-placeholder.ts
/public/media/products
/public/media/banners
/public/media/reviews
